# Enable the live Slack integration tests.
# Accepted values: 1, true
RUN_LIVE_SLACK_TESTS=false

# Bot token from Slack OAuth & Permissions (required for live tests)
SLACK_BOT_TOKEN=

# Channel id used for live integration tests (required for live channel tests)
SLACK_TEST_CHANNEL_ID=

# Optional: user id for host DM or ephemeral tests
SLACK_TEST_USER_ID=

# Optional: reaction name for host tests
SLACK_TEST_REACTION=wave

# Optional: signing secret for webhook verification tests / local ingress work
SLACK_SIGNING_SECRET=

# App-level token for the live Socket Mode tests (`connections:write`)
SLACK_APP_TOKEN=

# Workspace name checked before live test messages are sent
SLACK_TEST_WORKSPACE=epicfirm

# Optional: existing private Slack file for the download success test.
# Supply the exact expected UTF-8 contents. The token needs files:read.
SLACK_TEST_FILE_URL=
SLACK_TEST_FILE_CONTENT=

# Optional: run the real button/modal test with a browser or person.
RUN_LIVE_SLACK_UI_TESTS=false
